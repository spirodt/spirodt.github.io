@inherits LocalizedComponent
@inject IJSRuntime JS

<section class="section section-tint" id="software">
    <div class="container">
        <header class="section-head">
            <p class="eyebrow">@T("Софтвер", "Software")</p>
            <h2>@T(SiteContent.SoftwareTitle)</h2>
            <p class="lead">@T(SiteContent.SoftwareLead)</p>
        </header>
        <a class="rp-banner" href="restorani">
            <div>
                <span class="tag">@T("Ново", "New")</span>
                <h3>@T("БСС ПОС за ресторани", "BSS POS for restaurants")</h3>
                <p>@T("Мобилен ПОС за келнери, налози за кујна и шанк, фискални печатачи, работа без интернет и извештаи по вработен.",
                      "Mobile POS for waiters, kitchen and bar tickets, fiscal printers, offline operation and per-employee reports.")</p>
                <span class="rp-banner-link">@T("Погледни ги функциите", "See the features") <Icon Name="arrow" Size="18" /></span>
            </div>
            <img src="img/restorani/desktop-pos.webp" alt="@T("Десктоп ПОС со артикли и сметка", "Desktop POS with items and a bill")" loading="lazy" />
        </a>
        <div class="product-grid">
            @foreach (var p in SiteContent.Products)
            {
                <article class="product">
                    <div class="product-top">
                        <span class="card-icon small"><Icon Name="@p.Icon" Size="20" /></span>
                        <span class="tag">@T(p.Tag)</span>
                    </div>
                    <h3>@T(p.Name)</h3>
                    <p>@T(p.Text)</p>
                </article>
            }
        </div>
        <div class="center">
            <a class="btn btn-primary" href="download">
                <Icon Name="download" Size="18" /> @T("Преземи BSSR", "Download BSSR")
            </a>
            <button type="button" class="btn btn-ghost" @onclick='() => JS.InvokeVoidAsync("portfolio.scrollToSection", "contact")'>
                @T("Закажи бесплатно демо", "Book a free demo") <Icon Name="arrow" Size="18" />
            </button>
        </div>
    </div>
</section>
