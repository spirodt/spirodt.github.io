@inherits LocalizedComponent

<section class="section section-tint" id="pricing">
    <div class="container">
        <header class="section-head">
            <p class="eyebrow">@T("Цени", "Pricing")</p>
            <h2>@T(SiteContent.PricingTitle)</h2>
            <p class="lead">@T(SiteContent.PricingLead)</p>
        </header>

        <div class="tabs" role="tablist" aria-label="@T(SiteContent.PricingTitle)">
            @for (var i = 0; i < SiteContent.Pricing.Length; i++)
            {
                var index = i;
                <button type="button" role="tab" class="tab @(index == _active ? "active" : "")"
                        aria-selected="@Aria(index == _active)" @onclick="() => _active = index">
                    @T(SiteContent.Pricing[index].Title)
                </button>
            }
        </div>

        @{ var group = SiteContent.Pricing[_active]; }
        <div class="price-table" role="tabpanel">
            @foreach (var item in group.Items)
            {
                <div class="price-row">
                    <div class="price-name">
                        <span>@T(item.Name)</span>
                        @if (!string.IsNullOrEmpty(T(item.Note)))
                        {
                            <small>@T(item.Note)</small>
                        }
                    </div>
                    <span class="price-dots" aria-hidden="true"></span>
                    <strong class="price-value">@T(item.Price)</strong>
                </div>
            }
        </div>
        <p class="fine">@T(SiteContent.PricingNote)</p>
    </div>
</section>

@code {
    private int _active;
}
