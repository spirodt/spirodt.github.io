@inherits LocalizedComponent

<section class="section" id="projects">
    <div class="container">
        <header class="section-head">
            <p class="eyebrow">@T("Проекти", "Projects")</p>
            <h2>@T(SiteContent.ProjectsTitle)</h2>
        </header>
        <div class="project-grid">
            @foreach (var p in SiteContent.Projects)
            {
                <article class="project">
                    <p class="project-kind">@T(p.Kind)</p>
                    <h3>@T(p.Name)</h3>
                    <p>@T(p.Text)</p>
                    <ul class="highlights">
                        @foreach (var h in p.Highlights)
                        {
                            <li>@T(h)</li>
                        }
                    </ul>
                    <ul class="chips small">
                        @foreach (var tech in p.Tech)
                        {
                            <li>@tech</li>
                        }
                    </ul>
                </article>
            }
        </div>

        <a class="pf-teaser" href="portfolio">
            <div>
                <p class="eyebrow">@T("Приказна за успех", "Success story")</p>
                <h3>@T("Wi-Fi мрежа за ресторан долг 145 метри", "Wi-Fi for a restaurant 145 metres long")</h3>
                <p>@T("Ресторан на падина, со повеќе објекти и тераси: споредба на четири опции, план со цртежи и мрежа без прекини за мобилната каса.",
                      "A restaurant on a slope with several buildings and terraces: four options compared, a drawn plan and a network the mobile POS can rely on.")</p>
                <span class="pf-teaser-link">@T("Прочитајте ја приказната", "Read the story") <Icon Name="arrow" Size="18" /></span>
            </div>
            <div class="pf-teaser-stats" aria-hidden="true">
                <div><strong>145 m</strong><span>@T("локација", "site")</span></div>
                <div><strong>6</strong><span>@T("точки", "points")</span></div>
                <div><strong>4</strong><span>@T("опции", "options")</span></div>
            </div>
        </a>
    </div>
</section>
