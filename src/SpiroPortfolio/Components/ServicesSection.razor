@inherits LocalizedComponent
@inject IJSRuntime JS

<section class="section" id="services">
    <div class="container">
        <header class="section-head">
            <p class="eyebrow">@T("Услуги", "Services")</p>
            <h2>@T(SiteContent.ServicesTitle)</h2>
            <p class="lead">@T(SiteContent.ServicesLead)</p>
        </header>

        <div class="svc-filter" role="group" aria-label="@T("Филтрирај услуги", "Filter services")">
            <button type="button" class="svc-chip @(_cat is null ? "active" : "")" aria-pressed="@Aria(_cat is null)"
                    @onclick="() => _cat = null">
                @T("Сите", "All") <span class="svc-count">@SiteContent.Services.Length</span>
            </button>
            @foreach (var c in SiteContent.ServiceCategories)
            {
                var id = c.Id;
                <button type="button" class="svc-chip @(_cat == id ? "active" : "")" aria-pressed="@Aria(_cat == id)"
                        @onclick="() => _cat = id">
                    @T(c.Name) <span class="svc-count">@SiteContent.Services.Count(s => s.Category == id)</span>
                </button>
            }
        </div>

        <div class="svc-grid">
            @foreach (var s in Visible)
            {
                <article class="svc" @key="s.Art">
                    <div class="svc-art" data-cat="@s.Category">@((MarkupString)ServiceArtLibrary.Get(s.Art))</div>
                    <div class="svc-body">
                        <span class="svc-cat" data-cat="@s.Category">@T(CategoryName(s.Category))</span>
                        <h3>@T(s.Title)</h3>
                        <p>@T(s.Text)</p>
                        <ul class="ticks">
                            @foreach (var point in s.Points)
                            {
                                <li><Icon Name="check" Size="16" /> @T(point)</li>
                            }
                        </ul>
                    </div>
                </article>
            }
            <article class="card card-cta">
                <h3>@T("Не сте сигурни што ви треба?", "Not sure what you need?")</h3>
                <p>@T("Опишете го проблемот со свои зборови — јас ќе предложам решение и цена, без обврска.",
                      "Describe the problem in your own words — I'll suggest a solution and a price, no obligation.")</p>
                <button type="button" class="btn btn-light" @onclick='() => JS.InvokeVoidAsync("portfolio.scrollToSection", "contact")'>
                    @T("Прашај бесплатно", "Ask for free") <Icon Name="arrow" Size="18" />
                </button>
            </article>
        </div>
    </div>
</section>

@code {
    private string? _cat;

    private IEnumerable<ServiceItem> Visible =>
        _cat is null ? SiteContent.Services : SiteContent.Services.Where(s => s.Category == _cat);

    private static Loc CategoryName(string id) =>
        SiteContent.ServiceCategories.First(c => c.Id == id).Name;
}
