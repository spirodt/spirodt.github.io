@* BSS — Business Software Solutions. Знакот: „B“ меѓу заграден код, килибарна точка. *@
<span class="logo @(Inverse ? "logo-inverse" : "")">
    @((MarkupString)Mark)
    <span class="logo-text">
        <strong>@SiteContent.BrandName</strong>
        <small>@SiteContent.BrandFull</small>
    </span>
</span>

@code {
    [Parameter] public bool Inverse { get; set; }

    // Знакот е SVG низа (не Razor markup) за <text> да не го протолкува Razor.
    private const string Mark =
        """<svg class="logo-mark" viewBox="0 0 40 40" width="38" height="38" aria-hidden="true"><rect class="logo-bg" width="40" height="40" rx="10"/><path class="logo-fg" d="M12.5 13.5 8 20l4.5 6.5M27.5 13.5 32 20l-4.5 6.5" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity=".55"/><text class="logo-letter" x="20" y="27.2" text-anchor="middle" font-family="Manrope, system-ui, sans-serif" font-weight="800" font-size="19">B</text><circle cx="31" cy="9" r="3" fill="#f5a524"/></svg>""";
}
