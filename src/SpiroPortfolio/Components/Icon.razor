<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "code":
            <polyline points="8 6 2 12 8 18" /><polyline points="16 6 22 12 16 18" /><line x1="14" y1="4" x2="10" y2="20" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
            break;
        case "wrench":
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.2L3.5 17.3a1.8 1.8 0 0 0 2.5 2.5l5.8-5.8a4 4 0 0 0 5.2-5.4l-2.5 2.5-2.3-.3-.3-2.3z" />
            break;
        case "network":
            <rect x="9" y="3" width="6" height="5" rx="1" /><rect x="3" y="16" width="6" height="5" rx="1" /><rect x="15" y="16" width="6" height="5" rx="1" /><path d="M12 8v4M6 16v-2h12v2" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 4.5-3.3 8.3-8 9-4.7-.7-8-4.5-8-9V6z" /><polyline points="8.5 12 11 14.5 15.5 9.5" />
            break;
        case "cart":
            <circle cx="9" cy="20" r="1.3" /><circle cx="18" cy="20" r="1.3" /><path d="M2.5 3h3l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L21 7H6.3" />
            break;
        case "receipt":
            <path d="M5 3h14v18l-2.5-1.6L14 21l-2-1.6L10 21l-2.5-1.6L5 21z" /><path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "building":
            <rect x="4" y="3" width="16" height="18" rx="1" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3" />
            break;
        case "wallet":
            <path d="M3 7a2 2 0 0 1 2-2h13v4" /><rect x="3" y="7" width="18" height="13" rx="2" /><circle cx="16.5" cy="13.5" r="1.2" />
            break;
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="M8 14h3v3H8z" />
            break;
        case "badge":
            <circle cx="12" cy="9" r="6" /><path d="M8.5 13.8 7 21l5-2.5 5 2.5-1.5-7.2" /><polyline points="9.5 9 11.3 10.8 14.5 7.5" />
            break;
        case "phone":
            <path d="M5 3h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 5.1 5.1l1.4-2.3L19 13.5V17a2 2 0 0 1-2 2A15 15 0 0 1 3 5a2 2 0 0 1 2-2z" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" /><polyline points="3 7 12 13 21 7" />
            break;
        case "pin":
            <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
            break;
        case "linkedin":
            <rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
            break;
        case "chat":
            <path d="M4 5h16v11H9l-5 4z" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "check":
            <polyline points="5 12.5 10 17 19 7" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15.5 14" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            break;
        case "windows":
            <path d="M3 5.5 10.5 4.5v7H3zM12 4.3 21 3v8.5h-9zM3 12.5h7.5v7L3 18.5zM12 12.5h9V21l-9-1.3z" />
            break;
        case "folder":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            break;
        case "facebook":
            <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H7v3.5h2V21h3.5v-8.5h2.6L15.5 9h-3V7a1 1 0 0 1 1-1H15z" />
            break;
        case "instagram":
            <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" />
            break;
        case "whatsapp":
            <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.5-4.3A8.5 8.5 0 1 1 20.5 11.6z" /><path d="M9 8.2c-.4 1.9 2.4 5.4 5 5.9.7.1 1.3-.4 1.5-1l-1.6-1-1 .7c-1-.4-2-1.4-2.4-2.4l.7-1-1-1.6c-.5.1-1 .2-1.2.4z" />
            break;
        case "viber":
            <path d="M12 3c5 0 8.5 2.2 8.5 7.5S17 18 12 18l-3.5 3v-3.4C5 16.6 3.5 14 3.5 10.5 3.5 5.2 7 3 12 3z" /><path d="M9.3 7.6c.2 2.6 2.2 4.8 4.9 5.2l.9-1-1.4-.9-.7.5c-.8-.4-1.6-1.1-2-2l.5-.7-.9-1.4z" /><path d="M13 6.5a3.5 3.5 0 0 1 3 3M13 4.8a5.2 5.2 0 0 1 4.7 4.7" />
            break;
        case "link":
            <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7L12 6.3" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
            break;
        case "share":
            <circle cx="18" cy="5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="19" r="2.5" /><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4" />
            break;
        case "gift":
            <rect x="3" y="8" width="18" height="4" rx="1" /><path d="M5 12v8h14v-8M12 8v12" /><path d="M12 8C10.5 4 7 4 7 6s3 2 5 2zM12 8c1.5-4 5-4 5-2s-3 2-5 2z" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string? Class { get; set; }
}
