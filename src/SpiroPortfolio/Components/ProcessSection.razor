@inherits LocalizedComponent

<section class="section" id="process">
    <div class="container">
        <header class="section-head center-head">
            <p class="eyebrow">@T("Процес", "Process")</p>
            <h2>@T(SiteContent.ProcessTitle)</h2>
        </header>
        <ol class="process">
            @foreach (var step in SiteContent.Process)
            {
                <li class="step">
                    <span class="step-num">@step.Number</span>
                    <h3>@T(step.Title)</h3>
                    <p>@T(step.Text)</p>
                </li>
            }
        </ol>
    </div>
</section>
