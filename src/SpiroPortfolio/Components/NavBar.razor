@inherits LocalizedComponent
@inject LanguageService Language
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="topbar">
    <div class="container topbar-inner">
        <span><Icon Name="pin" Size="15" /> @T(SiteContent.Contact.Area)</span>
        <span class="topbar-hours"><Icon Name="clock" Size="15" /> @T(SiteContent.Hours)</span>
        <a href="mailto:@SiteContent.Contact.PrimaryEmail" class="topbar-mail"><Icon Name="mail" Size="15" /> @SiteContent.Contact.PrimaryEmail</a>
        <a href="@SiteContent.Contact.PhoneHref" class="topbar-phone"><Icon Name="phone" Size="15" /> @SiteContent.Contact.Phone</a>
    </div>
</div>

<header class="nav @(_open ? "is-open" : "")">
    <div class="container nav-inner">
        <a class="brand" href="" @onclick="() => Go(null)" @onclick:preventDefault aria-label="@T("Почетна", "Home")">
            <Logo />
        </a>

        <nav class="nav-links" aria-label="@T("Главна навигација", "Main navigation")">
            @foreach (var (id, label) in SiteContent.Nav)
            {
                if (id is "download" or "refer")
                {
                    <a href="@id" class="nav-page @(IsPage(id) ? "active" : "")" @onclick="() => _open = false">
                        <Icon Name="@(id == "download" ? "download" : "gift")" Size="16" /> @T(label)
                    </a>
                }
                else
                {
                    <a href="#@id" @onclick="() => Go(id)" @onclick:preventDefault>@T(label)</a>
                }
            }
        </nav>

        <div class="nav-actions">
            <ThemeToggle />
            <div class="lang-picker">
                <Icon Name="globe" Size="16" />
                <select aria-label="@T("Јазик", "Language")" value="@LanguageService.Code(Lang)" @onchange="OnLanguageChanged">
                    @foreach (var l in Languages.All)
                    {
                        <option value="@l.Code" title="@l.Native">@l.Short</option>
                    }
                </select>
            </div>
            <a class="btn btn-primary btn-sm nav-cta" href="@SiteContent.Contact.PhoneHref">
                <Icon Name="phone" Size="16" /> @T("Јави се", "Call")
            </a>
            <button type="button" class="nav-toggle" aria-expanded="@Aria(_open)"
                    aria-label="@T("Мени", "Menu")" @onclick="() => _open = !_open">
                <Icon Name="@(_open ? "close" : "menu")" />
            </button>
        </div>
    </div>
</header>

@code {
    private bool _open;

    private bool IsHome => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0;
    private bool IsPage(string page) => Nav.ToBaseRelativePath(Nav.Uri).StartsWith(page, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _open = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private Task OnLanguageChanged(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        foreach (var l in Languages.All)
            if (l.Code == code) return Language.SetAsync(l.Lang);
        return Task.CompletedTask;
    }

    private async Task Go(string? id)
    {
        _open = false;
        if (!IsHome)
        {
            // Од друга страна (пр. /download): прво назад на почетна, па скролај кога секцијата ќе се појави.
            Nav.NavigateTo("");
        }
        await JS.InvokeVoidAsync("portfolio.scrollToSection", id ?? "top");
    }
}
