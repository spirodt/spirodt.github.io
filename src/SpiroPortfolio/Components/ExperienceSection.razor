@inherits LocalizedComponent

<section class="section section-tint" id="experience">
    <div class="container narrow">
        <header class="section-head">
            <p class="eyebrow">@T("Искуство", "Experience")</p>
            <h2>@T(SiteContent.ExperienceTitle)</h2>
            <p class="lead">@T(SiteContent.ExperienceLead)</p>
        </header>
        <ol class="timeline">
            @foreach (var item in SiteContent.Timeline)
            {
                <li class="timeline-item">
                    <span class="timeline-period">@T(item.Period)</span>
                    <div class="timeline-body">
                        <h3>@T(item.Title)</h3>
                        <p>@T(item.Text)</p>
                        <ul class="chips small">
                            @foreach (var tech in item.Tech)
                            {
                                <li>@tech</li>
                            }
                        </ul>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>
