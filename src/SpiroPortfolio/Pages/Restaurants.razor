    private Task Scroll(string id) => JS.InvokeVoidAsync("portfolio.scrollToSection", id).AsTask();

    private void Zoom(string image, Loc caption)
    {
        _zoom = image;
        _zoomCaption = caption;
        _focusLightbox = true;
    }

    private void CloseZoom()
    {
        _zoom = null;
        _zoomCaption = default;
    }

    private void OnLightboxKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseZoom();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLightbox && _zoom is not null)
        {
            _focusLightbox = false;
            try { await _lightbox.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }
}
