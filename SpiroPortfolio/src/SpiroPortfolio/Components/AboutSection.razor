@inherits LocalizedComponent

<section class="section" id="about">
    <div class="container about-grid">
        <div>
            <p class="eyebrow">@T("Кој сум јас", "Who I am")</p>
            <h2>@T(SiteContent.AboutTitle)</h2>
            @foreach (var p in SiteContent.AboutParagraphs)
            {
                <p class="prose">@T(p)</p>
            }
        </div>
        <div class="skills">
            @foreach (var group in SiteContent.Skills.GroupBy(s => s.Group))
            {
                <div class="skill-group">
                    <h3>@T(group.Key)</h3>
                    <ul class="chips">
                        @foreach (var skill in group)
                        {
                            <li>@skill.Name</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>
