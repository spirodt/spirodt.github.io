@inherits LocalizedComponent

<span class="logo @(Inverse ? "logo-inverse" : "")">
    <svg class="logo-mark" viewBox="0 0 40 40" width="38" height="38" aria-hidden="true">
        <rect width="40" height="40" rx="10" fill="var(--navy)" />
        <path d="M13 13.5 8.5 20 13 26.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
        <path d="M27 13.5 31.5 20 27 26.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
        <path d="M23.6 14.6c-.9-1-2.2-1.6-3.7-1.6-2.3 0-3.9 1.3-3.9 3.1 0 4.2 8.2 2.6 8.2 7 0 1.9-1.7 3.3-4.2 3.3-1.7 0-3.2-.7-4.1-1.9"
              fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
        <circle cx="31" cy="9" r="3" fill="var(--amber)" />
    </svg>
    <span class="logo-text">
        <strong>@T("Спиро", "Spiro")</strong>
        <small>@T("ИТ решенија", "IT solutions")</small>
    </span>
</span>

@code {
    [Parameter] public bool Inverse { get; set; }
}
