@inherits LocalizedComponent

<footer class="footer">
    <div class="container footer-grid">
        <div class="footer-brand">
            <Logo Inverse="true" />
            <p>@T("Софтвер, веб, сервис на компјутери, мрежи и бекап за фирми и домаќинства во Скопје.",
                  "Software, web, computer repair, networks and backup for businesses and homes in Skopje.")</p>
        </div>
        <div>
            <h4>@T("Услуги", "Services")</h4>
            <ul>
                @foreach (var s in SiteContent.Services)
                {
                    <li>@T(s.Title)</li>
                }
            </ul>
        </div>
        <div>
            <h4>@T("Контакт", "Contact")</h4>
            <ul>
                <li><a href="@SiteContent.Contact.PhoneHref">@SiteContent.Contact.Phone</a></li>
                <li><a href="@SiteContent.Contact.ViberHref">Viber</a> · <a href="@SiteContent.Contact.WhatsAppHref" target="_blank" rel="noopener">WhatsApp</a></li>
                @if (SiteContent.Contact.HasEmail)
                {
                    <li><a href="mailto:@SiteContent.Contact.Email">@SiteContent.Contact.Email</a></li>
                }
                <li>@T(SiteContent.Contact.Area)</li>
                <li>@T(SiteContent.Hours)</li>
            </ul>
        </div>
    </div>
    <div class="container footer-bottom">
        <p>© @DateTime.Now.Year @T("Спиро — ИТ решенија", "Spiro — IT solutions")</p>
        <a href="@SiteContent.Contact.LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn"><Icon Name="linkedin" Size="20" /></a>
    </div>
</footer>
