@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Language
@inject NavigationManager Nav

@if (_ready)
{
    <CascadingValue Value="Language.Current">
        <NavBar />
        <main id="top">
            @Body
        </main>
        <SiteFooter />
        <MobileCallBar />
    </CascadingValue>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Language.Changed += OnLanguageChanged;

        var uri = new Uri(Nav.Uri);
        string? lang = null;
        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("lang", StringComparison.OrdinalIgnoreCase))
                lang = Uri.UnescapeDataString(kv[1]);
        }

        await Language.InitializeAsync(lang);
        _ready = true;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Language.Changed -= OnLanguageChanged;
}
